# --- TiDB Cloud connection -------------------------------------------------
# Cluster overview -> Connect -> "Connect With" = General / Python
TIDB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxxxxx.root
TIDB_PASSWORD=
TIDB_DB=airport_search
# TiDB Cloud Starter requires TLS; leave as-is unless you use a custom CA.
TIDB_SSL_VERIFY=true

# --- Embeddings ------------------------------------------------------------
# Any OpenAI-compatible endpoint works. 1536 dims must match VECTOR(1536).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
