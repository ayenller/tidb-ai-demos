# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Env / secrets
.env
.env.local
*.pem

# Downloaded datasets — regenerated by each demo's own scripts.
# A pattern containing a slash is anchored to this file's directory, so these
# need the ** prefix to reach 01-*/data/ too.
**/data/*.dat
**/data/*.csv
**/data/*.json
**/data/*.geojson
!**/data/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

